---
// Font family is provided by Astro's native Fonts API (see `fonts` in
// astro.config.ts and <Font /> in Layout.astro), exposed as `--font-inter`.
// To switch typefaces, change the `fonts` entry and repoint `--aw-font-*` below.
---

<style is:inline>
  :root {
    --aw-font-sans: 'Golos Text', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Golos Text', ui-sans-serif, system-ui, sans-serif;
    --aw-font-heading: 'Golos Text', ui-sans-serif, system-ui, sans-serif;

    --aw-color-primary: rgb(11 61 145);
    --aw-color-secondary: rgb(8 42 102);
    --aw-color-accent: rgb(230 57 70);

    --aw-color-text-heading: rgb(16 24 40);
    --aw-color-text-default: rgb(16 24 40);
    --aw-color-text-muted: rgb(102 112 133);
    --aw-color-bg-page: rgb(255 255 255);

    --aw-color-bg-page-dark: rgb(8 9 10);

    ::selection {
      background-color: lavender;
    }
  }

  .dark {
    --aw-font-sans: 'Golos Text', ui-sans-serif, system-ui, sans-serif;
    --aw-font-serif: 'Golos Text', ui-sans-serif, system-ui, sans-serif;
    --aw-font-heading: 'Golos Text', ui-sans-serif, system-ui, sans-serif;

    --aw-color-primary: rgb(11 61 145);
    --aw-color-secondary: rgb(8 42 102);
    --aw-color-accent: rgb(230 57 70);

    --aw-color-text-heading: rgb(247, 248, 248);
    --aw-color-text-default: rgb(229 236 246);
    --aw-color-text-muted: rgb(229 236 246 / 66%);
    --aw-color-bg-page: rgb(8 9 10);

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
