---
import Base from '~/layouts/Base.astro';
import CtaOsago from '~/components/CtaOsago.astro';
import ShareBar from '~/components/ShareBar.astro';
import coefs from '~/data/osago_coefficients_2026.json';

export async function getStaticPaths() {
  const MAP = { 'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd', 'е': 'e', 'ё': 'e', 'ж': 'zh', 'з': 'z', 'и': 'i', 'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm', 'н': 'n', 'о': 'o', 'п': 'p', 'р': 'r', 'с': 's', 'т': 't', 'у': 'u', 'ф': 'f', 'х': 'kh', 'ц': 'ts', 'ч': 'ch', 'ш': 'sh', 'щ': 'shch', 'ъ': '', 'ы': 'y', 'ь': '', 'э': 'e', 'ю': 'yu', 'я': 'ya' };
  const slugify = (s) => 'osago-v-' + s.replace(/\([^)]*\)/g, '').toLowerCase().split('').map((ch) => MAP[ch] ?? ch).join('').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  const ktFmt = (v) => v.toFixed(2).replace('.', ',').replace(',00', '');
  const fmt = (n) => n.toLocaleString('ru-RU');

  const tbFiz = coefs.tb.find((t) => t.cat.startsWith('B,BE физлица'));
  const kvsRow = (age, exp) => coefs.kvs_auto.find((r) => r.age === age)?.[exp];
  const price = (kt, km, kvs, kbm, ko = 1, ks = 1) => { const f = kt * km * kvs * kbm * ko * ks; return { min: Math.round(tbFiz.min * f), max: Math.round(tbFiz.max * f) }; };

  const ZONES = {};
  for (const z of coefs.kt_full) { const s = slugify(z.territory); if (!ZONES[s]) ZONES[s] = z; }
  const byKt = {};
  for (const z of coefs.kt_full) { (byKt[z.kt] = byKt[z.kt] || []).push(z); }

  const SKIP = new Set(['osago-v-moskva']);
  return Object.entries(ZONES)
    .filter(([slug]) => !SKIP.has(slug))
    .map(([slug, zone]) => {
      const kt = zone.kt;
      const price1 = price(kt, 1.2, kvsRow('35-39', 'стаж 5-6'), 1.0);
      const price2 = price(kt, 1.2, kvsRow('22-24', 'стаж 0'), 1.17);
      const price3 = price(kt, 1.2, kvsRow('50-59', 'стаж 10-14'), 0.46);
      const tier = kt >= 1.56 ? 'одна из самых дорогих зон страны' : kt >= 1.24 ? 'зона с ценой выше среднего по России' : kt > 1.0 ? 'зона около среднего по России' : 'одна из самых доступных зон России';
      const ratio = kt < 1.8 ? `в ${(1.8 / kt).toFixed(1).replace('.', ',')} раза дешевле, чем в Москве` : 'дороже, чем в Москве';
      const cheaper = coefs.kt_full.filter((z) => z.kt < zone.kt).length;
      const leadPara = `Стоимость ОСАГО в зоне ${zone.territory} в 2026 году — от ${fmt(price1.min)} до ${fmt(price1.max)} ₽ в год для водителя 35–39 лет со стажем 5–6 лет на автомобиле 101–120 л.с. (КТ ${ktFmt(kt)}): базовый тариф в коридоре 1 399–8 665 ₽ умножается на коэффициенты, поэтому итоговая цена зависит от страховой компании.`;
      const faq = [
        { q: `Сколько стоит ОСАГО в 2026 году в зоне ${zone.territory}?`, a: `Территориальный коэффициент (КТ) для ${zone.territory} — ${ktFmt(kt)}. Для автомобиля мощностью 101–120 л.с. при полисе на год цена варьирует от ${fmt(price3.min)} ₽ (водитель 50–59 лет со стажем 10–14 лет, класс КБМ 13) до ${fmt(price2.max)} ₽ (водитель 22–24 лет без стажа). Точная цифра зависит ещё и от базового тарифа конкретной страховой — он выбирается внутри коридора 1 399–8 665 ₽.` },
        { q: `Что означает КТ ${ktFmt(kt)} для ${zone.territory}?`, a: `КТ — территориальный коэффициент из Указания Банка России № 7204-У. Он умножается на базовый тариф вместе с КВС, КБМ, КМ и другими коэффициентами. Значение ${ktFmt(kt)} делает ${zone.territory} ${tier}: дешевле, чем здесь, цены в ${cheaper} зонах из 192.` },
        { q: 'Можно ли сэкономить, оформив полис по другому адресу?', a: 'КТ определяется по месту регистрации собственника автомобиля, а не по месту его использования. Регистрация по другому адресу ради снижения КТ незаконна и может привести к признанию полиса недействительным и отказу в выплате.' },
      ];
      const ldFaq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
      const ldBc = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://polisprice.ru/' },
        { '@type': 'ListItem', position: 2, name: 'Все регионы', item: 'https://polisprice.ru/osago/regiony/' },
        { '@type': 'ListItem', position: 3, name: zone.territory } ] };
      return {
        params: { slug },
        props: {
          zone, slug, kt, ktStr: ktFmt(kt),
          sameKt: (byKt[zone.kt] || []).filter((z) => slugify(z.territory) !== slug).slice(0, 4)
            .map((z) => ({ slug: slugify(z.territory), territory: z.territory })),
          cheaper, price1, price2, price3, tier, ratio, faq, ldFaq, ldBc, leadPara,
          ktStrTr: ktFmt(zone.kt_traktor),
          kvs1: kvsRow('35-39', 'стаж 5-6'), kvs2: kvsRow('22-24', 'стаж 0'), kvs3: kvsRow('50-59', 'стаж 10-14'),
        },
      };
    });
}

const { zone, slug, kt, ktStr, ktStrTr, sameKt, cheaper, price1, price2, price3, tier, ratio, faq, ldFaq, ldBc, kvs1, kvs2, kvs3, leadPara } = Astro.props;
const fmt = (n) => n.toLocaleString('ru-RU');
---

<Base title={`ОСАГО в 2026 году: ${zone.territory} — КТ ${ktStr}, цены`} description={`Расчёт ОСАГО для зоны ${zone.territory}: КТ ${ktStr} по Указанию ЦБ № 7204-У. Примеры цен для авто 101–120 л.с. от ${fmt(price3.min)} до ${fmt(price2.max)} ₽, сравнение с Москвой и соседними зонами.`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ldBc)} />
  <nav class="text-sm text-slate-500"><a href="/" class="hover:text-indigo-600">Главная</a> / <a href="/polisprice/osago/regiony/" class="hover:text-indigo-600">Все регионы</a> / <span class="text-slate-700">{zone.territory}</span></nav>
  <p class="mt-3 text-sm font-medium text-indigo-600">Коэффициенты проверены 2026-11-07 · Указание ЦБ № 7204-У (ред. 04.05.2026)</p>
  <h1 class="mt-2 text-3xl font-bold">Сколько стоит ОСАГО в 2026 году: {zone.territory} (КТ {ktStr})</h1>
  <p class="mt-3 max-w-2xl text-slate-600">{leadPara}</p>
  <p class="mt-2 max-w-2xl text-slate-600">{zone.territory} — тарифная зона № {zone.n} с КТ {ktStr}: {tier}, полис здесь {ratio}. Цены ниже, чем здесь, — в {cheaper} зонах из 192.</p>

  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-xl font-bold">Примеры расчёта для {zone.territory} (101–120 л.с., КМ 1,2, полис на год)</h2>
    <div class="mt-4 overflow-x-auto"><table class="w-full min-w-[640px] text-sm">
      <thead><tr class="text-left text-slate-500"><th class="py-2">Водитель</th><th>КВС</th><th>КБМ</th><th>Цена: мин — макс, ₽</th></tr></thead>
      <tbody>
        <tr class="border-t border-slate-100"><td class="py-2">35–39 лет, стаж 5–6 лет, класс КБМ 4</td><td>{kvs1}</td><td>1,00</td><td class="font-medium">{fmt(price1.min)} — {fmt(price1.max)}</td></tr>
        <tr class="border-t border-slate-100"><td class="py-2">22–24 года, стаж 0, класс КБМ 3</td><td>{kvs2}</td><td>1,17</td><td class="font-medium">{fmt(price2.min)} — {fmt(price2.max)}</td></tr>
        <tr class="border-t border-slate-100"><td class="py-2">50–59 лет, стаж 10–14 лет, класс КБМ 13</td><td>{kvs3}</td><td>0,46</td><td class="font-medium">{fmt(price3.min)} — {fmt(price3.max)}</td></tr>
      </tbody>
    </table></div>
    <p class="mt-3 text-sm text-slate-500">Минимальная цена в строке — если страховая выбрала нижнюю границу базового тарифа (1 399 ₽), максимальная — верхнюю (8 665 ₽). Фактический тариф у большинства компаний ближе к нижней половине коридора.</p>
  </section>

  <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-xl font-bold">Коэффициенты зоны {zone.n}</h2>
    <div class="mt-4 overflow-x-auto"><table class="w-full min-w-[420px] text-sm">
      <tbody>
        <tr class="border-t border-slate-100"><td class="py-2">КТ для легковых автомобилей</td><td class="font-semibold">{ktStr}</td></tr>
        <tr class="border-t border-slate-100"><td class="py-2">КТ для тракторов и спецтехники</td><td class="font-semibold">{ktStrTr}</td></tr>
        <tr class="border-t border-slate-100"><td class="py-2">Сравнение с Москвой (КТ 1,8)</td><td class="font-semibold">{ratio}</td></tr>
      </tbody>
    </table></div>
    <p class="mt-3 text-sm text-slate-500">Для сравнения: в соседних по уровню цен зонах — <a href="/polisprice/osago/koeffitsienty/" class="text-indigo-600 hover:underline">полная таблица всех 192 зон</a>.</p>
  </section>

  <section class="mt-6">
    <h2 class="text-xl font-bold">Частые вопросы об ОСАГО в {zone.territory}</h2>
    {faq.map((f) => (
      <details class="mt-3 rounded-xl border border-slate-200 bg-white p-4">
        <summary class="cursor-pointer font-medium">{f.q}</summary>
        <p class="mt-2 text-sm text-slate-600">{f.a}</p>
      </details>
    ))}
  </section>

  <section class="mt-8 rounded-2xl border border-indigo-100 bg-indigo-50 p-6">
    <h2 class="text-xl font-bold">Посчитайте точную цену</h2>
    <p class="mt-2 text-slate-600">В примерах выше — диапазон по всему тарифному коридору. Калькулятор считает по вашей конкретной машине и стажу.</p>
    <a href="/polisprice/osago/kalkulyator/" class="mt-4 inline-block rounded-full bg-indigo-600 px-5 py-2.5 font-medium text-white hover:bg-indigo-700">Открыть калькулятор ОСАГО</a>
  </section>

  <CtaOsago />
  <ShareBar />
  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-lg font-bold">Источники данных</h2>
    <ul class="mt-3 space-y-1 list-disc pl-5 text-sm text-slate-600">
      <li>Формула расчёта и предельные базовые тарифы — Указание Банка России от 09.10.2025 № 7204-У (ред. 04.05.2026): <a href="https://www.cbr.ru/insurance/" class="text-indigo-600 hover:underline" rel="nofollow noopener" target="_blank">cbr.ru — страховой рынок</a></li>
      <li>История страхований и класс КБМ — база РСА: <a href="https://autoins.ru/" class="text-indigo-600 hover:underline" rel="nofollow noopener" target="_blank">autoins.ru — Российский союз автостраховщиков</a></li>
    </ul>
  </section>

<section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-lg font-bold">Читать по теме</h2>
    <ul class="mt-3 space-y-1 list-disc pl-5 text-sm">
      <li><a href="/polisprice/guides/kak-snizit-tsenu-osago/" class="text-indigo-600 hover:underline">7 способов снизить цену ОСАГО</a></li>
      <li><a href="/polisprice/guides/tarifnyy-koridor/" class="text-indigo-600 hover:underline">Тарифный коридор: почему цены различаются</a></li>
    </ul>
  </section>

  {sameKt.length > 0 && (
    <section class="mt-8">
      <h2 class="text-lg font-bold">Зоны с тем же КТ {ktStr}</h2>
      <ul class="mt-3 flex flex-wrap gap-2 text-sm">
        {sameKt.map((z) => <li class="rounded-full border border-slate-200 bg-white px-3 py-1"><a href={`/${z.slug}/`} class="hover:text-indigo-600">{z.territory}</a></li>)}
      </ul>
    </section>
  )}
</Base>
