---
import Base from '~/layouts/Base.astro';
import CtaOsago from '~/components/CtaOsago.astro';
import ShareBar from '~/components/ShareBar.astro';
import coefs from '~/data/osago_coefficients_2026.json';
import mr from '~/data/models_matrix.json';
const fmt = (n) => n.toLocaleString('ru-RU');
const mskKt = mr.regions.find((r) => r.zone === 'Москва').kt;
const tb = coefs.tb.find((t) => t.cat.startsWith('B,BE физлица'));
const kvsRow = Object.fromEntries(coefs.kvs_auto.map((r) => [r.age, r]));
const kmMid = coefs.km_auto.find(([k]) => k === '101-120')[1];
const demoMin = Math.round(tb.min * mskKt * kmMid * kvsRow['50-59']['стаж 10-14'] * coefs.kbm.classes['13']);
const demoMax = Math.round(tb.max * mskKt * kmMid * kvsRow['50-59']['стаж 10-14'] * coefs.kbm.classes['13']);
const top = mr.models.slice(0, 12);
const rest = mr.models.slice(12);
const faq = [
  { q: 'Сколько стоит ОСАГО на популярную модель в Москве?', a: `Для средней категории мощности 101–120 л.с. опытный водитель (50+, стаж 10–14 лет, класс КБМ 13) платит от ${fmt(demoMin)} до ${fmt(demoMax)} ₽ в год — по КТ Москвы 1,8 и коридору базовых тарифов 1 399–8 665 ₽. Новичок без стажа и низкий класс КБМ умножают цену в разы.` },
  { q: 'Почему для одной модели цены различаются по регионам?', a: 'КТ задаётся местом регистрации собственника: разница между самой дорогой и самой дешёвой зоной страны — почти в 3,5 раза. На каждой странице модели есть таблица по всем 28 регионам матрицы и список зон региона.' },
  { q: 'Какую мощность брать для расчёта?', a: 'Мощность берите из ПТС вашей конкретной модификации. Страницы моделей показывают цены для всех шести категорий КМ от 0,6 до 1,6, а калькулятор считает точную комбинацию коэффициентов.' },
];
const ldFaq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---

<Base title="ОСАГО на популярные модели авто 2026: расчёт по регионам" description="Расчёт ОСАГО на Lada Granta, Kia Rio, Toyota Camry, Haval Jolion и другие модели по всем регионам России: коэффициенты ЦБ, шесть категорий мощности, три профиля водителя.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
  <h1 class="text-3xl font-bold">ОСАГО на модели авто: расчёт по регионам</h1>
  <p class="mt-3 max-w-2xl text-slate-600">Выберите модель — для каждой показан расчёт по всем регионам: шесть категорий мощности (КМ от 0,6 до 1,6), три профиля водителя и территориальный коэффициент зоны регистрации. Все числа считаются из коэффициентов Указания ЦБ № 7204-У при сборке страницы.</p>
  <h2 class="mt-8 text-2xl font-bold">Самые популярные модели</h2>
  <ul class="mt-4 grid gap-2 sm:grid-cols-2">
    {top.map((m) => <li class="rounded-xl border border-slate-200 bg-white p-4 hover:shadow-md transition-shadow"><a href={`/osago/${m.slug}/moskva/`} class="font-medium hover:text-indigo-600">{m.name}</a><span class="ml-2 text-sm text-slate-500">— расчёт по всем регионам</span></li>)}
  </ul>
  <h2 class="mt-8 text-2xl font-bold">Все модели</h2>
  <ul class="mt-4 flex flex-wrap gap-2 text-sm">
    {rest.map((m) => <li class="rounded-full border border-slate-200 bg-white px-3 py-1"><a href={`/osago/${m.slug}/moskva/`} class="hover:text-indigo-600">{m.name}</a></li>)}
  </ul>
  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-xl font-bold">Частые вопросы</h2>
    {faq.map((f) => (
      <details class="mt-3 rounded-xl border border-slate-200 bg-white p-4">
        <summary class="cursor-pointer font-medium">{f.q}</summary>
        <p class="mt-2 text-sm text-slate-600">{f.a}</p>
      </details>
    ))}
  </section>
  <CtaOsago />
  <ShareBar />
</Base>
