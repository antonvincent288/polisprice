---
import Base from '~/layouts/Base.astro';
import coefs from '~/data/osago_coefficients_2026.json';
const ktSorted = [...coefs.kt_full].sort((a, b) => a.territory.localeCompare(b.territory, 'ru'));
const kvsTable = {};
coefs.kvs_auto.forEach((row) => {
  Object.entries(row).forEach(([k, v]) => {
    if (k !== 'age') kvsTable[row.age + '|' + k] = v;
  });
});
const ages = coefs.kvs_auto.map((r) => r.age);
const exps = Object.keys(coefs.kvs_auto[0]).filter((k) => k !== 'age');
const ageLabels = { '18-21': '18–21 год', '22-24': '22–24 года', '25-29': '25–29 лет', '30-34': '30–34 года', '35-39': '35–39 лет', '40-49': '40–49 лет', '50-59': '50–59 лет', '59+': '59 и старше' };
const expLabels = { 'стаж 0': 'менее 1 года', 'стаж 1': '1 год', 'стаж 2': '2 года', 'стаж 3-4': '3–4 года', 'стаж 5-6': '5–6 лет', 'стаж 7-9': '7–9 лет', 'стаж 10-14': '10–14 лет', 'стаж 14+': 'более 14 лет' };
const tbFiz = coefs.tb.find((t) => t.cat.startsWith('B,BE физлица'));
const kbmItems = Object.entries(coefs.kbm.classes).reverse();
const koItems = [['ограниченный полис (список водителей)', 1.0], ['неограниченный полис (физлицо)', 3.16]];
const ksItems = Object.entries(coefs.ks);
const calcFaq = JSON.parse('[[\"Сколько стоит ОСАГО на машину в 2026 году?\", \"Средняя зона страны имеет КТ 1,16. Для водителя 35–39 лет со стажем 5–6 лет, машины 101–120 л.с. и стартовым классом КБМ 3 расчёт даёт 2 210–13 689 ₽ в год; в Москве (КТ 1,8) — 3 429–21 241 ₽. Весь разброс шире: от 218 ₽ (самая дешёвая зона, маломощный мотор, класс 13) до ~912 000 ₽ в экстремальных комбинациях — неограниченный полис на новичка в самой дорогой зоне с мотором свыше 150 л.с. и классом М.\"], [\"Что влияет на цену ОСАГО?\", \"Шесть множителей формулы: территориальный коэффициент КТ — 0,68–2,34 по 192 зонам, мощность КМ — 0,6–1,6, возраст и стаж КВС — 0,83–2,27, класс КБМ — 0,46–3,92, число водителей КО и срок полиса КС. Базовый тариф страховая выбирает в коридоре 1 399–8 665 ₽ — отсюда разница между компаниями при одинаковых коэффициентах.\"], [\"Почему у соседа полис дешевле при той же машине?\", \"Чаще всего это КБМ: класс 13 даёт скидку 54%, а класс М повышает цену почти в 4 раза — 10 142 ₽ в год на московском сценарии. Вторая причина — КТ: он задаётся местом регистрации собственника. Третья — КВС: новичок 22–24 лет без стажа дороже опытного водителя примерно в 2,7 раза.\"]]');
const calcLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: calcFaq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base title="Калькулятор ОСАГО 2026 — по коэффициентам ЦБ" description="Интерактивный расчёт ОСАГО по формуле Указания ЦБ 7204-У: КТ, КБМ, КВС, КМ, КО, КС. Диапазон цены по коридору базовых тарифов 1399–8665 ₽.">
<script slot="head" type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@type": "BreadcrumbList", itemListElement: [{ "@type": "ListItem", position: 1, name: "Главная", item: "https://polisprice.ru/" }, { "@type": "ListItem", position: 2, name: "ОСАГО" }] })} />
<script slot="head" type="application/ld+json" set:html={JSON.stringify(calcLd)} />
  <h1 class="text-3xl font-bold">Калькулятор ОСАГО 2026</h1>
  <p class="mt-2 max-w-2xl text-slate-600">Заполните параметры — калькулятор посчитает диапазон цены по формуле Указания ЦБ № 7204-У. Диапазон зависит от того, какой базовый тариф страховая выбрала внутри коридора.</p>
  <div class="mt-8 grid gap-8 md:grid-cols-2">
    <div class="rounded-2xl border border-slate-200 bg-white p-6">
      <h2 class="font-semibold text-slate-900">Параметры полиса</h2>
      <div class="mt-4 space-y-4 text-sm">
        <label class="block" data-tour data-tour-title="Самый важный множитель" data-tour-desc="КТ зависит от места регистрации собственника: в Москве коэффициент 1,8, а в маленьких городах — меньше единицы. Разница — до половины цены полиса."><span class="text-slate-600">Территория регистрации (КТ)</span>
          <select id="f-kt" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
            {ktSorted.map((r) => <option value={r.kt} data-coef={r.kt}>{r.territory} — КТ {r.kt.toString().replace('.', ',')}</option>)}
          </select>
        </label>
        <label class="block"><span class="text-slate-600">Мощность двигателя (КМ)</span>
          <select id="f-km" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
            {coefs.km_auto.map(([r, v]) => <option value={v} data-coef={v}>{r} л.с. — КМ {v.toString().replace('.', ',')}</option>)}
          </select>
        </label>
        <div class="grid grid-cols-2 gap-3">
          <label class="block"><span class="text-slate-600">Возраст (КВС)</span>
            <select id="f-age" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
              {ages.map((a) => <option value={a}>{ageLabels[a]}</option>)}
            </select>
          </label>
          <label class="block"><span class="text-slate-600">Стаж (КВС)</span>
            <select id="f-exp" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
              {exps.map((e) => <option value={e}>{expLabels[e]}</option>)}
            </select>
          </label>
        </div>
        <label class="block" data-tour data-tour-title="Ваша безаварийная скидка" data-tour-desc="КБМ от 0,46 до 3,92: год без аварий по вашей вине повышает класс на один. Класс 13 — скидка 54%, класс М — надбавка почти в 4 раза."><span class="text-slate-600">Класс КБМ (бонус-малус)</span>
          <select id="f-kbm" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
            {kbmItems.map(([cls, v]) => <option value={v} data-coef={v}>Класс {cls} — {v.toString().replace('.', ',')}</option>)}
          </select>
        </label>
        <label class="block" data-tour data-tour-title="Один или несколько водителей" data-tour-desc="В ограниченном полисе цена считается по худшему из вписанных водителей. Неограниченный полис выгоден, если машиной пользуется много людей со разным стажем."><span class="text-slate-600">Количество водителей (КО)</span>
          <select id="f-ko" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
            {koItems.map(([l, v]) => <option value={v} data-coef={v}>{l} — КО {v.toString().replace('.', ',')}</option>)}
          </select>
        </label>
        <label class="block"><span class="text-slate-600">Срок страхования (КС)</span>
          <select id="f-ks" class="mt-1 w-full rounded-lg border border-slate-300 px-3 py-2">
            {ksItems.map(([l, v]) => <option value={v} data-coef={v}>{l} — КС {v.toString().replace('.', ',')}</option>)}
          </select>
        </label>
      </div>
    </div>
    <div class="md:sticky md:top-24 md:self-start">
      <div class="rounded-2xl border border-indigo-100 bg-white p-6">
        <h2 class="font-semibold text-slate-900">Результат расчёта</h2>
        <div id="result" class="mt-4">Загрузка расчёта…</div>
      </div>
      <p class="mt-4 rounded-xl bg-amber-50 p-4 text-xs text-amber-800">Расчёт справочный: показывает диапазон по предельным значениям базового тарифа ({tbFiz.min.toLocaleString('ru-RU')}–{tbFiz.max.toLocaleString('ru-RU')} ₽ для физлиц и ИП). Реальная цена — то, что конкретная страховая выбрала внутри коридора. Расчёт не является офертой.</p>
    </div>
  </div>
  <section class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 text-sm text-slate-600">
    <h2 class="font-semibold text-slate-900">Как работает расчёт</h2>
    <p class="mt-2">Цена = ТБ × КТ × КБМ × КВС × КО × КМ × КС. Страховая выбирает базовый тариф ТБ в коридоре 1 399–8 665 ₽ (с 09.12.2025, легковые физлиц/ИП) — поэтому для одних и тех же коэффициентов цена различается между компаниями. КБМ обновляется 1 апреля ежегодно. Проверить свой КБМ можно на сайте РСА.</p>
  </section>

  <section class="mt-10">
    <h2 class="text-xl font-bold">Частые вопросы о расчёте ОСАГО</h2>
    {calcFaq.map(([q, a]) => (
      <details class="mt-3 rounded-xl border border-slate-200 bg-white p-4">
        <summary class="cursor-pointer font-medium">{q}</summary>
        <p class="mt-2 text-sm text-slate-600">{a}</p>
      </details>
    ))}
  </section>
  <script define:vars={{ kvsTable, tbMin: tbFiz.min, tbMax: tbFiz.max }}>
    function fmt(n) { return Math.round(n).toLocaleString('ru-RU'); }
    function coefOf(id) {
      const opt = document.getElementById(id).selectedOptions[0];
      return opt ? parseFloat(opt.dataset.coef) : null;
    }
    function calc() {
      const kt = coefOf('f-kt'), km = coefOf('f-km'), kbm = coefOf('f-kbm'), ko = coefOf('f-ko'), ks = coefOf('f-ks');
      const age = document.getElementById('f-age').value;
      const exp = document.getElementById('f-exp').value;
      const kvs = kvsTable[age + '|' + exp];
      const el = document.getElementById('result');
      if (kvs == null) {
        el.innerHTML = '<p class="mt-4 rounded-xl bg-red-50 p-4 text-sm text-red-700">Для выбранной комбинации возраста и стажа отдельного коэффициента нет — уточните параметры.</p>';
        return;
      }
      const f = kt * km * kbm * kvs * ko * ks;
      const min = Math.round(tbMin * f), max = Math.round(tbMax * f);
      const rows = [['КТ', kt], ['КМ', km], ['КВС', kvs], ['КО', ko], ['КС', ks], ['КБМ', kbm]]
        .map(([n, v]) => '<span class="rounded-lg bg-slate-100 px-2 py-1">' + n + ' ' + String(v).replace('.', ',') + '</span>').join(' ');
      el.innerHTML =
        '<p class="mt-4 text-sm text-slate-500">Произведение коэффициентов: ' + f.toFixed(3).replace('.', ',') + '</p>' +
        '<p class="mt-2 text-sm text-slate-500">Диапазон цены полиса на 10+ месяцев:</p>' +
        '<p class="mt-1 text-3xl font-bold text-indigo-700">' + fmt(min) + ' — ' + fmt(max) + ' ₽</p>' +
        '<p class="mt-3 text-sm text-slate-600">Для одного и того же водителя компании дают разные числа внутри этого диапазона — сравните предложения перед покупкой.</p>' +
        '<div class="mt-4 flex flex-wrap gap-2 text-xs">' + rows + '</div>';
    }
    ['f-kt', 'f-km', 'f-kbm', 'f-ko', 'f-ks', 'f-age', 'f-exp'].forEach((id) => document.getElementById(id).addEventListener('change', calc));
    calc();
  </script>

  <div class="mt-6 rounded-2xl border border-indigo-100 bg-indigo-50 p-4">
    <p class="text-sm">Не уверены в коэффициентах? <a class="font-semibold text-indigo-600 hover:underline" href="/polisprice/quiz/">Пройдите квиз из 4 вопросов</a> — покажем вашу вилку цены за минуту.</p>
  </div>
  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-5">
    <p class="text-lg font-bold">Как это работает</p>
    <div class="mt-3 grid gap-2 sm:grid-cols-3 text-sm text-slate-600">
      <div><span class="font-bold text-indigo-600">1.</span> Выберите коэффициенты — каждый подписан и объяснён.</div>
      <div><span class="font-bold text-indigo-600">2.</span> Калькулятор считает по Указанию № 7204-У (ред. 04.05.2026), 192 тарифные зоны.</div>
      <div><span class="font-bold text-indigo-600">3.</span> Без регистрации и сбора данных: считайте спокойно и сравнивайте компании.</div>
    </div>
    <p class="mt-3 text-sm text-slate-600">Пример: Москва, авто 101–120 л.с., опытный водитель 50+ с классом КБМ 13 — от 1 150 до 7 150 ₽ в год — числа считает та же формула, что и выше.</p>
  </div>
  <link rel="stylesheet" href="/polisprice/driver.css" slot="head" />
  <script is:inline src="/driver.js" slot="head"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (!window.driver) return;
      if (sessionStorage.getItem('pp_tour_done')) return;
      const steps = Array.prototype.slice.call(document.querySelectorAll('[data-tour]')).map(function (el) {
        return { element: el, popover: { title: el.getAttribute('data-tour-title'), description: el.getAttribute('data-tour-desc') } };
      });
      if (!steps.length) return;
      const make = window.driver.js && window.driver.js.driver ? window.driver.js.driver : window.driver;
      const d = make({ showProgress: true, nextBtnText: 'Дальше', prevBtnText: 'Назад', doneBtnText: 'Понятно', progressText: '{{current}} из {{total}}', steps: steps });
      d.drive();
      sessionStorage.setItem('pp_tour_done', '1');
    });
  </script>
</Base>
