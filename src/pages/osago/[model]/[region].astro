---
import Base from '~/layouts/Base.astro';
import CtaOsago from '~/components/CtaOsago.astro';
import ShareBar from '~/components/ShareBar.astro';
import coefs from '~/data/osago_coefficients_2026.json';
import mr from '~/data/models_matrix.json';

export async function getStaticPaths() {
  const out = [];
  for (const m of mr.models) {
    for (const rg of mr.regions) {
      out.push({ params: { model: m.slug, region: rg.slug }, props: { m, rg } });
    }
  }
  return out;
}

const { m, rg } = Astro.props;
const ktFmt = (v) => v.toFixed(2).replace('.', ',').replace(',00', '');
const fmt = (n) => n.toLocaleString('ru-RU');
const kt = rg.kt;
const tbFiz = coefs.tb.find((t) => t.cat.startsWith('B,BE физлица'));
const kvsRow = Object.fromEntries(coefs.kvs_auto.map((r) => [r.age, r]));
const kvsPro = { exp: kvsRow['50-59']['стаж 10-14'], mid: kvsRow['35-39']['стаж 5-6'], nov: kvsRow['22-24']['стаж 0'] };
const kbms = { exp: coefs.kbm.classes['13'], mid: coefs.kbm.classes['4'], nov: coefs.kbm.classes['3'] };
const kmList = coefs.km_auto;
const kmMin = kmList[0][1], kmMax = kmList[kmList.length - 1][1];
const kmMinS = kmMin.toString().replace('.', ','), kmMaxS = kmMax.toString().replace('.', ',');
const price = (km, kvsV, kbm) => {
  const min = Math.round(tbFiz.min * kt * km * kvsV * kbm);
  const max = Math.round(tbFiz.max * kt * km * kvsV * kbm);
  return [min, max];
};
const rows = kmList.map(([label, km]) => {
  const f = (pair) => `${fmt(pair[0])} — ${fmt(pair[1])}`;
  return [`${label} л.с. — КМ ${km.toString().replace('.', ',')}`, f(price(km, kvsPro.exp, kbms.exp)), f(price(km, kvsPro.mid, kbms.mid)), f(price(km, kvsPro.nov, kbms.nov))];
});
const allMin = Math.min(...kmList.map(([km]) => price(km, kvsPro.exp, kbms.exp)[0]));
const allMax = Math.max(...kmList.map(([km]) => price(km, kvsPro.nov, kbms.nov)[1]));
const mskKt = mr.regions.find((r) => r.zone === 'Москва').kt;
const ratio = kt < mskKt ? `в ${(mskKt / kt).toFixed(1).replace('.', ',')} раза дешевле, чем в Москве` : kt === mskKt ? 'по уровню цен совпадает с Москвой' : `в ${(kt / mskKt).toFixed(1).replace('.', ',')} раза дороже, чем в Москве`;
const geoLink = rg.geo_path === 'osago/moscow' ? '/osago/moscow/' : '/' + rg.geo_path + '/';
const faq = [
  { q: `Сколько стоит ОСАГО на ${m.name} для региона ${rg.name}?`, a: `Годовой полис на ${m.name} по зоне ${rg.zone} лежит в диапазоне от ${fmt(allMin)} до ${fmt(allMax)} ₽ — итог зависит от мощности конкретной модификации (КМ от ${kmMinS} до ${kmMaxS}) и профиля водителя. КТ зоны ${rg.zone} — ${ktFmt(kt)}, базовый тариф страховая выбирает в коридоре 1 399–8 665 ₽.` },
  { q: 'Как считается цена полиса?', a: `Цена = базовый тариф × КТ × КМ × КВС × КБМ. Для зоны ${rg.zone} КТ равен ${ktFmt(kt)}, мощность берётся из ПТС (КМ), КВС — по возрасту и стажу, КБМ — по безаварийной истории. Разбор формулы — в гайде «Как считается ОСАГО».` },
  { q: 'Как снизить цену ОСАГО на эту машину?', a: `Главный рычаг — класс КБМ: класс 13 даёт скидку 54%, а класс М повышает цену почти в 4 раза. Второй рычаг — сравнение базовых тарифов компаний: коридор 1 399–8 665 ₽ даёт разброс в разы при одинаковых коэффициентах. Полный список приёмов — в гайде «7 способов снизить цену ОСАГО».` },
];
const ldFaq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const ldBc = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://polisprice.ru/' },
  { '@type': 'ListItem', position: 2, name: 'Модели авто', item: 'https://polisprice.ru/osago/na-avtomobili/' },
  { '@type': 'ListItem', position: 3, name: m.name + ' — ' + rg.name } ] };
---

<Base title={`ОСАГО на ${m.name}: ${rg.name} 2026 — расчёт стоимости`} description={`Расчёт ОСАГО на ${m.name} для региона ${rg.name} по коэффициентам ЦБ: КТ ${ktFmt(kt)} (${rg.zone}), шесть категорий мощности, три профиля водителя. Диапазон от ${fmt(allMin)} до ${fmt(allMax)} ₽.`}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ldFaq)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ldBc)} />
  <nav class="text-sm text-slate-500"><a href="/" class="hover:text-indigo-600">Главная</a> / <a href="/osago/na-avtomobili/" class="hover:text-indigo-600">Модели авто</a> / <span class="text-slate-700">{m.name} — {rg.name}</span></nav>
  <p class="mt-3 text-sm font-medium text-indigo-600">Коэффициенты проверены 2026-11-07 · Указание ЦБ № 7204-У (ред. 04.05.2026)</p>
  <h1 class="mt-2 text-3xl font-bold">Сколько стоит ОСАГО на {m.name}: {rg.name}, расчёт 2026 года</h1>
  <p class="mt-3 max-w-2xl text-slate-600">Годовой полис на {m.name} по зоне {rg.zone} стоит от {fmt(allMin)} до {fmt(allMax)} ₽ — итог зависит от мощности конкретной модификации (КМ от {kmMinS} до {kmMaxS}) и профиля водителя. КТ зоны {rg.zone} — {ktFmt(kt)}, что делает этот регион {ratio}. Полная таблица для всех категорий мощности — ниже.</p>

  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-xl font-bold">Цены для {m.name}: мощность × профиль водителя</h2>
    <p class="mt-2 text-sm text-slate-500">Мощность берите из ПТС: модификация на 106 л.с. — это категория 101–120. Диапазон в каждой ячейке — по коридору базовых тарифов 1 399–8 665 ₽.</p>
    <div class="mt-4 overflow-x-auto"><table class="w-full min-w-[640px] text-sm">
      <thead><tr class="text-left text-slate-500"><th class="py-2">Мощность (КМ)</th><th>Опытный: 50+, стаж 10–14, КБМ 13</th><th>Средний: 35–39, стаж 5–6, КБМ 4</th><th>Новичок: 22–24, стаж 0, КБМ 3</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr class="border-t border-slate-100">
            <td class="py-2">{r[0]}</td><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td>
          </tr>
        ))}
      </tbody>
    </table></div>
    <p class="mt-3 text-sm text-slate-500">КТ зоны {rg.zone} — {ktFmt(kt)}. {rg.direct ? 'Зона задана напрямую по Указанию № 7204-У.' : `Расчёт по КТ зоны ${rg.zone}: КТ задаётся местом регистрации собственника — в других городах региона значения свои; все зоны региона — в списке ниже.`}</p>
  </section>

  <section class="mt-6 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-lg font-bold">Что учесть при расчёте</h2>
    <ul class="mt-3 space-y-1.5 list-disc pl-5 text-sm text-slate-600">
      <li>Мощность — из ПТС: она определяет КМ, разница между крайними категориями — почти в 2,7 раза по итоговой цене.</li>
      <li>Место регистрации собственника — КТ {ktFmt(kt)} для {rg.zone}; <a href={geoLink} class="text-indigo-600 hover:underline">подробная страница зоны {rg.zone}</a>.</li>
      <li>Класс КБМ — по безаварийной истории: класс 13 дешевле класса М почти в 4 раза.</li>
      <li>Точный расчёт под вашу модификацию — <a href="/osago/kalkulyator/" class="text-indigo-600 hover:underline">в калькуляторе ОСАГО</a>.</li>
    </ul>
  </section>

  <section class="mt-6">
    <h2 class="text-xl font-bold">Частые вопросы</h2>
    {faq.map((f) => (
      <details class="mt-3 rounded-xl border border-slate-200 bg-white p-4">
        <summary class="cursor-pointer font-medium">{f.q}</summary>
        <p class="mt-2 text-sm text-slate-600">{f.a}</p>
      </details>
    ))}
  </section>

  <CtaOsago />
  <ShareBar />
  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-lg font-bold">Источники данных</h2>
    <ul class="mt-3 space-y-1 list-disc pl-5 text-sm text-slate-600">
      <li>Формула расчёта и предельные базовые тарифы — Указание Банка России от 09.10.2025 № 7204-У (ред. 04.05.2026): <a href="https://www.cbr.ru/insurance/" class="text-indigo-600 hover:underline" rel="nofollow noopener" target="_blank">cbr.ru — страховой рынок</a></li>
      <li>История страхований и класс КБМ — база страховых историй (НСИС): <a href="https://nsis.ru/" class="text-indigo-600 hover:underline" rel="nofollow noopener" target="_blank">nsis.ru</a></li>
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold">Зоны региона {rg.name}</h2>
    <ul class="mt-3 flex flex-wrap gap-2 text-sm">
      <li class="rounded-full border border-slate-200 bg-white px-3 py-1"><a href={geoLink} class="hover:text-indigo-600">{rg.zone} — КТ {ktFmt(kt)}</a></li>
      {rg.alts.map((a) => <li class="rounded-full border border-slate-200 bg-white px-3 py-1"><a href={a.path} class="hover:text-indigo-600">{a.territory} — КТ {ktFmt(a.kt)}</a></li>)}
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold">{m.name} в других регионах</h2>
    <ul class="mt-3 flex flex-wrap gap-2 text-sm">
      {mr.regions.filter((x) => x.slug !== rg.slug).map((x) => <li class="rounded-full border border-slate-200 bg-white px-3 py-1"><a href={`/osago/${m.slug}/${x.slug}/`} class="hover:text-indigo-600">{x.name}</a></li>)}
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold">Популярные модели для этого региона</h2>
    <ul class="mt-3 flex flex-wrap gap-2 text-sm">
      {mr.models.slice(0, 12).filter((x) => x.slug !== m.slug).map((x) => <li class="rounded-full border border-slate-200 bg-white px-3 py-1"><a href={`/osago/${x.slug}/${rg.slug}/`} class="hover:text-indigo-600">{x.name}</a></li>)}
    </ul>
  </section>

  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-lg font-bold">Читать по теме</h2>
    <ul class="mt-3 space-y-1 list-disc pl-5 text-sm">
      <li><a href="/guides/kak-schitaetsya-osago/" class="text-indigo-600 hover:underline">Как считается ОСАГО: формула и коэффициенты</a></li>
      <li><a href="/guides/kbm-klassy-i-skidka/" class="text-indigo-600 hover:underline">КБМ: все классы и скидки</a></li>
      <li><a href="/guides/kak-snizit-tsenu-osago/" class="text-indigo-600 hover:underline">7 способов снизить цену ОСАГО</a></li>
    </ul>
  </section>
</Base>
