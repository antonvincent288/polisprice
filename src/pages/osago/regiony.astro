---
import Base from '~/layouts/Base.astro';
import coefs from '~/data/osago_coefficients_2026.json';

const MAP = { 'а': 'a', 'б': 'b', 'в': 'v', 'г': 'g', 'д': 'd', 'е': 'e', 'ё': 'e', 'ж': 'zh', 'з': 'z', 'и': 'i', 'й': 'y', 'к': 'k', 'л': 'l', 'м': 'm', 'н': 'n', 'о': 'o', 'п': 'p', 'р': 'r', 'с': 's', 'т': 't', 'у': 'u', 'ф': 'f', 'х': 'kh', 'ц': 'ts', 'ч': 'ch', 'ш': 'sh', 'щ': 'shch', 'ъ': '', 'ы': 'y', 'ь': '', 'э': 'e', 'ю': 'yu', 'я': 'ya' };
const slugify = (s) => 'osago-v-' + s.replace(/\([^)]*\)/g, '').toLowerCase().split('').map((ch) => MAP[ch] ?? ch).join('').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
const ktFmt = (v) => v.toFixed(2).replace('.', ',').replace(',00', '');

const sorted = [...coefs.kt_full].sort((a, b) => b.kt - a.kt);
const groups = [];
for (const z of sorted) {
  const s = slugify(z.territory);
  if (['osago-v-moskva'].includes(s)) continue;
  const g = groups.find((x) => x.kt === z.kt);
  if (g) g.items.push(z); else groups.push({ kt: z.kt, items: [z] });
}
const ld = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://polisprice.ru/' },
  { '@type': 'ListItem', position: 2, name: 'Все регионы' } ] };
---
<Base title="ОСАГО по регионам 2026: все 192 тарифные зоны КТ" description="Полный список 192 тарифных зон ОСАГО по Указанию ЦБ № 7204-У: территориальный коэффициент каждой зоны, города и регионы от самых дорогих до самых дешёвых.">
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <h1 class="text-3xl font-bold">ОСАГО по регионам: все 192 тарифные зоны</h1>
  <p class="mt-3 max-w-2xl text-slate-600">Территориальный коэффициент (КТ) — второй по силе фактор цены полиса после КБМ. Чем выше КТ вашей зоны регистрации, тем дороже ОСАГО. Ниже — все 192 зоны по Указанию Банка России № 7204-У (ред. от 04.05.2026), от самых дорогих до самых дешёвых. На странице каждого региона — примеры цен и расчёт.</p>
  {groups.map((g) => (
    <section class="mt-6">
      <h2 class="text-lg font-bold">КТ {ktFmt(g.kt)}</h2>
      <ul class="mt-2 flex flex-wrap gap-2 text-sm">
        {g.items.map((z) => <li class="rounded-full border border-slate-200 bg-white px-3 py-1"><a href={`/${slugify(z.territory)}/`} class="hover:text-indigo-600">{z.territory}</a></li>)}
      </ul>
    </section>
  ))}

  <section class="mt-10" id="site-search">
    <h2 class="text-xl font-bold">Поиск по сайту</h2>
    <link rel="stylesheet" href="/polisprice/pagefind/pagefind-ui.css" slot="head" />
    <script is:inline src="/pagefind/pagefind-ui.js" slot="head"></script>
    <div id="search" class="mt-4"></div>
    <script is:inline>
      window.addEventListener('DOMContentLoaded', () => {
        if (!window.PagefindUI) return;
        new PagefindUI({ element: '#search', showSubResults: true, translations: {
          placeholder: 'Поиск по сайту',
          clear_search: 'Очистить',
          load_more: 'Ещё результаты',
          search_label: 'Поиск',
          zero_results: 'Ничего не найдено: «[SEARCH_TERM]»',
          many_results: 'Найдено [COUNT] результатов: «[SEARCH_TERM]»',
          one_result: 'Найден [COUNT] результат: «[SEARCH_TERM]»',
          searching: 'Ищем «[SEARCH_TERM]»…'
        } });
      });
    </script>
  </section>
</Base>
