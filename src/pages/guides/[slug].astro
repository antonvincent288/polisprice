---
import Base from '~/layouts/Base.astro';
import CtaOsago from '~/components/CtaOsago.astro';
import ShareBar from '~/components/ShareBar.astro';
import guides from '~/data/guides.json';

export async function getStaticPaths() {
  return guides.map((g) => ({
    params: { slug: g.slug },
    props: { g, ld: g.ld, bc: {
      '@context': 'https://schema.org', '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://polisprice.ru/' },
        { '@type': 'ListItem', position: 2, name: 'Гайды', item: 'https://polisprice.ru/guides/' },
        { '@type': 'ListItem', position: 3, name: g.title } ] } },
  }));
}

const { g, ld, bc } = Astro.props;
  const art = {
      '@context': 'https://schema.org', '@type': 'Article',
      headline: g.title, description: g.desc,
      datePublished: g.datePublished, dateModified: g.dateModified,
      inLanguage: 'ru-RU',
      author: { '@type': 'Organization', name: 'ПолисПрайс', url: 'https://polisprice.ru/' },
      publisher: { '@type': 'Organization', name: 'ПолисПрайс', url: 'https://polisprice.ru/' },
      mainEntityOfPage: 'https://polisprice.ru/guides/' + g.slug + '/',
    };
---

<Base title={g.title} description={g.desc}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(art)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(bc)} />
  <nav class="text-sm text-slate-500"><a href="/" class="hover:text-indigo-600">Главная</a> / <a href="/polisprice/guides/" class="hover:text-indigo-600">Гайды</a> / <span class="text-slate-700">{g.title}</span></nav>
  <p class="mt-3 text-sm font-medium text-indigo-600">Коэффициенты проверены 07.11.2026 · Указание ЦБ № 7204-У (ред. 04.05.2026)</p>
  <article class="prose-slate max-w-3xl" set:html={g.body} />
  <section class="mt-8">
    <h2 class="text-xl font-bold">Другие гайды</h2>
    <ul class="mt-3 grid gap-2 sm:grid-cols-2">
      {guides.filter((x) => x.slug !== g.slug).map((x) => <li class="rounded-xl border border-slate-200 bg-white p-4 hover:shadow-md transition-shadow"><a href={`/polisprice/guides/${x.slug}/`} class="font-medium hover:text-indigo-600">{x.title}</a></li>)}
    </ul>
  </section>
<CtaOsago />
  <ShareBar />
  <section class="mt-8 rounded-2xl border border-slate-200 bg-white p-6">
    <h2 class="text-lg font-bold">Источники данных</h2>
    <ul class="mt-3 space-y-1 list-disc pl-5 text-sm text-slate-600">
      <li>Формула расчёта и предельные базовые тарифы — Указание Банка России от 09.10.2025 № 7204-У (ред. 04.05.2026): <a href="https://www.cbr.ru/insurance/" class="text-indigo-600 hover:underline" rel="nofollow noopener" target="_blank">cbr.ru — страховой рынок</a></li>
      <li>История страхований и класс КБМ — база РСА: <a href="https://autoins.ru/" class="text-indigo-600 hover:underline" rel="nofollow noopener" target="_blank">autoins.ru — Российский союз автостраховщиков</a></li>
    </ul>
  </section>

</Base>

<script is:inline>
  window.addEventListener('DOMContentLoaded', function () {
    var bar = document.getElementById('reading-progress-bar');
    if (!bar) return;
    function upd() {
      var h = document.documentElement;
      var frac = h.scrollTop / Math.max(1, h.scrollHeight - h.clientHeight);
      bar.style.width = (Math.min(1, Math.max(0, frac)) * 100) + '%';
    }
    window.addEventListener('scroll', upd, { passive: true });
    upd();
  });
</script>