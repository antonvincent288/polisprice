---
import '~/assets/styles/tailwind.css';
import site from '~/data/site.json';
import YandexAnalytics from '~/components/YandexAnalytics.astro';
const { title = 'ПолисПрайс', description = '', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://polisprice.ru').href;
const ogImage = new URL('/og-image.png', Astro.site ?? 'https://polisprice.ru').href;
const nav = [
  { href: '/osago/kalkulyator/', label: 'Калькулятор' },
  { href: '/osago/koeffitsienty/', label: 'Коэффициенты' },
  { href: '/osago/tarify/', label: 'Тарифы' },
  { href: '/osago/regiony/', label: 'Все регионы' },
  { href: '/osago/moscow/', label: 'ОСАГО в Москве' },
  { href: '/osago/na-avtomobili/', label: 'Модели авто' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="ПолисПрайс — гайды" href="/rss.xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="ПолисПрайс" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ПолисПрайс — посчитай свой полис ОСАГО" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {noindex && <meta name="robots" content="noindex" />}
    {site.yandexVerification && <meta name="yandex-verification" content={site.yandexVerification} />}
    <slot name="head" />
      <YandexAnalytics />
  <style is:global>@font-face {
  font-family: 'Golos Text';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('/fonts/golos-text-700-cyrillic-ext.woff2') format('woff2');
  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;
}
@font-face {
  font-family: 'Golos Text';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('/fonts/golos-text-700-cyrillic.woff2') format('woff2');
  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
}
@font-face {
  font-family: 'Golos Text';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('/fonts/golos-text-700-latin.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
/* === Дизайн-волна: типографика и полировка (батч 21) === */
h1, h2, h3, .display {
  font-family: 'Golos Text', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  letter-spacing: -0.02em;
}
@supports (text-wrap: balance) {
  h1, h2, h3 { text-wrap: balance; }
}
@supports (text-wrap: pretty) {
  p { text-wrap: pretty; }
}
main table {
  width: 100%;
  border-collapse: collapse;
  font-variant-numeric: tabular-nums;
}
main th, main td {
  border: 1px solid #e2e8f0;
  padding: 0.5rem 0.75rem;
  text-align: left;
}
main thead th { background: #f8fafc; font-weight: 700; }
main tr:nth-child(even) td { background: #fbfcfe; }
details {
  border: 1px solid #e2e8f0;
  border-radius: 0.75rem;
  padding: 0.25rem 0.75rem;
  background: #fff;
}
details + details { margin-top: 0.5rem; }
details summary {
  cursor: pointer;
  font-weight: 600;
  padding: 0.5rem 0.25rem;
  user-select: none;
}
details summary:hover { color: #4f46e5; }
details[open] { padding-bottom: 0.5rem; }
details[open] summary { color: #4f46e5; }
main a { text-underline-offset: 2px; }
:focus-visible {
  outline: 2px solid #4f46e5;
  outline-offset: 2px;
  border-radius: 4px;
}
@media (prefers-reduced-motion: no-preference) {
  html { scroll-behavior: smooth; }
}
</style>
</head>
  <body class="bg-slate-50 text-slate-800 antialiased">
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur">
      <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-3 px-4 py-3">
        <a href="/" class="order-1 text-lg font-bold text-slate-900">Полис<span class="text-indigo-600">Прайс</span></a>
        <nav class="order-3 flex w-full gap-4 overflow-x-auto pb-1 text-sm md:order-2 md:w-auto md:gap-6">
          {nav.map((l) => <a class="whitespace-nowrap text-slate-600 hover:text-indigo-600" href={l.href}>{l.label}</a>)}
        </nav>
        <a href="/osago/kalkulyator/" class="order-2 rounded-full bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 md:order-3">Рассчитать ОСАГО</a>
      </div>
    </header>
    <main class="mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>
    <footer class="mt-12 border-t border-slate-200 bg-white">
      <div class="mx-auto max-w-5xl px-4 py-8 text-sm text-slate-500">
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <p class="font-semibold text-slate-700">ПолисПрайс</p>
            <p class="mt-2">Расчёты выполняются по Указанию Банка России от 09.10.2025 № 7204-У (ред. от 04.05.2026). Коэффициенты проверены 05.11.2026 по официальному тексту.</p>
          </div>
          <div>
            <p class="font-semibold text-slate-700">Разделы</p>
            <ul class="mt-2 space-y-1">
              {nav.map((l) => <li><a class="hover:text-indigo-600" href={l.href}>{l.label}</a></li>)}
              {[["/osago/regiony/", "Все 192 региона"], ["/o-proekte/", "О проекте"], ["/politika-konfidencialnosti/", "Политика конфиденциальности"], ["/oferta/", "Оферта"], ["/kontakty/", "Контакты"]].map(([href, label]) => <li><a class="hover:text-indigo-600" href={href}>{label}</a></li>)}
            </ul>
          </div>
        </div>
        <p class="mt-6 border-t border-slate-100 pt-4">Информация справочная и не является офертой. Итоговая цена полиса определяется страховой компанией. Все коэффициенты обновляются 1 апреля ежегодно.</p>
      </div>
    <div class="mt-4"><a href="/guides/" class="hover:text-indigo-600">Гайды по ОСАГО</a></div></footer>
  <script defer src="/vendor/quicklink.umd.js"></script>
    <script>
      window.addEventListener('load', function () {
        // prefetch включается только на боевом домене: на превью пути другие
        if (location.hostname === 'polisprice.ru' && window.quicklink) {
          window.quicklink.listen({ priority: true, timeout: 3000 });
        }
      });
    </script>
</body>
</html>
