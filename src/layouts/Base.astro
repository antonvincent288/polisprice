---
import '~/assets/styles/tailwind.css';
import site from '~/data/site.json';
import YandexAnalytics from '~/components/YandexAnalytics.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import AWHeader from '~/components/widgets/Header.astro';
import AWFooter from '~/components/widgets/Footer.astro';
import { headerData, footerData } from '~/navigation';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
const { title = 'ПолисПрайс', description = '', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/^\/polisprice/, ''), Astro.site ?? 'https://polisprice.ru').href;
const ogImage = new URL('/og-image.png', Astro.site ?? 'https://polisprice.ru').href;
const nav = [
  { href: '/osago/kalkulyator/', label: 'Калькулятор' },
  { href: '/osago/koeffitsienty/', label: 'Коэффициенты' },
  { href: '/osago/tarify/', label: 'Тарифы' },
  { href: '/osago/regiony/', label: 'Все регионы' },
  { href: '/osago/moscow/', label: 'ОСАГО в Москве' },
  { href: '/osago/na-avtomobili/', label: 'Модели авто' },
];
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/polisprice/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="ПолисПрайс — гайды" href="/polisprice/rss.xml" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="ПолисПрайс" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ПолисПрайс — посчитай свой полис ОСАГО" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {noindex && <meta name="robots" content="noindex" />}
    {site.yandexVerification && <meta name="yandex-verification" content={site.yandexVerification} />}
    <slot name="head" />
    <CustomStyles />
    <ApplyColorMode />
      <YandexAnalytics />
  <style is:global>@font-face {
  font-family: 'Golos Text';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('/polisprice/fonts/golos-text-700-cyrillic-ext.woff2') format('woff2');
  unicode-range: U+0460-052F, U+1C80-1C8A, U+20B4, U+2DE0-2DFF, U+A640-A69F, U+FE2E-FE2F;
}
@font-face {
  font-family: 'Golos Text';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('/polisprice/fonts/golos-text-700-cyrillic.woff2') format('woff2');
  unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
}
@font-face {
  font-family: 'Golos Text';
  font-style: normal;
  font-weight: 700;
  font-display: swap;
  src: url('/polisprice/fonts/golos-text-700-latin.woff2') format('woff2');
  unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
}
/* === Дизайн-волна: типографика и полировка (батч 21) === */
h1, h2, h3, .display {
  font-family: 'Golos Text', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
  letter-spacing: -0.02em;
}
@supports (text-wrap: balance) {
  h1, h2, h3 { text-wrap: balance; }
}
@supports (text-wrap: pretty) {
  p { text-wrap: pretty; }
}
main table {
  width: 100%;
  border-collapse: collapse;
  font-variant-numeric: tabular-nums;
}
main th, main td {
  border: 1px solid #e2e8f0;
  padding: 0.5rem 0.75rem;
  text-align: left;
}
main thead th { background: #f8fafc; font-weight: 700; }
main tr:nth-child(even) td { background: #fbfcfe; }
details {
  border: 1px solid #e2e8f0;
  border-radius: 0.75rem;
  padding: 0.25rem 0.75rem;
  background: #fff;
}
details + details { margin-top: 0.5rem; }
details summary {
  cursor: pointer;
  font-weight: 600;
  padding: 0.5rem 0.25rem;
  user-select: none;
}
details summary:hover { color: #4f46e5; }
details[open] { padding-bottom: 0.5rem; }
details[open] summary { color: #4f46e5; }
main a { text-underline-offset: 2px; }
:focus-visible {
  outline: 2px solid #4f46e5;
  outline-offset: 2px;
  border-radius: 4px;
}
@media (prefers-reduced-motion: no-preference) {
  html { scroll-behavior: smooth; }
}
</style>

<style is:inline>
  /* --- PolisPrice premium layer (batch 38) --- */
  html { -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; overflow-x: clip; }
  /* --- typographic scale (design-system pass, единая точка правды) --- */
  main h1 { font-size: clamp(2.25rem, 1rem + 2.8vw, 3.75rem) !important; line-height: 1.06 !important; letter-spacing: -0.022em; font-weight: 700; }
  main h2 { font-size: clamp(1.5rem, 1.25rem + 0.8vw, 1.875rem) !important; line-height: 1.2 !important; letter-spacing: -0.01em; font-weight: 700; }
  main h3 { font-size: 1.25rem !important; line-height: 1.35 !important; font-weight: 600; }
  main p, main li { line-height: 1.65; }
  main .text-xl, main .lead { line-height: 1.6; }
  table { font-variant-numeric: tabular-nums; }
  /* --- semantic tokens: unify indigo -> brand (единая точка правды) --- */
  .text-indigo-600, .text-indigo-500 { color: var(--pp-blue) !important; }
  .hover\:text-indigo-600:hover { color: var(--pp-blue) !important; }
  .hover\:border-indigo-400:hover { border-color: rgba(11, 61, 145, 0.45) !important; }
  .bg-indigo-600 { background-color: var(--pp-blue) !important; }
  .hover\:bg-indigo-500:hover { background-color: var(--pp-deep) !important; }
  .bg-indigo-50 { background-color: #EFF4FB !important; }
  .border-indigo-100, .border-indigo-200 { border-color: #D6E2F4 !important; }
  .text-primary { color: var(--aw-color-primary) !important; }
  /* --- focus states (доступность) --- */
  main a:focus-visible, main button:focus-visible, main summary:focus-visible,
  header a:focus-visible, header button:focus-visible {
    outline: 2px solid var(--pp-blue);
    outline-offset: 2px;
  }


  body { overflow-x: clip; }
  h1, h2, h3 { letter-spacing: -0.015em; }

  .pp-hero {
    position: relative; overflow: hidden; border-radius: 32px;
    padding: clamp(2.4rem, 6vw, 4.6rem);
    color: #fff;
    background:
      radial-gradient(720px 360px at 18% -8%, rgba(96,165,250,.38), transparent 62%),
      radial-gradient(560px 320px at 92% 12%, rgba(30,64,175,.5), transparent 60%),
      linear-gradient(158deg, #0a1f3d 0%, #0d2b55 48%, #113a72 100%);
    box-shadow: 0 24px 70px -28px rgba(13, 43, 85, .55), 0 2px 8px rgba(13, 43, 85, .18);
    isolation: isolate;
  }
  .pp-hero::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background-image:
      linear-gradient(rgba(255,255,255,.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.045) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(760px 480px at 24% 12%, black, transparent 74%);
    mask-image: radial-gradient(760px 480px at 24% 12%, black, transparent 74%);
  }
  .pp-hero-kicker {
    position: relative; z-index: 1;
    font-size: .78rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase;
    color: #9cc2ff;
  }
  .pp-hero-title {
    position: relative; z-index: 1;
    margin-top: .9rem;
    font-size: clamp(2.15rem, 5vw, 3.5rem);
    line-height: 1.06; font-weight: 800; letter-spacing: -0.02em;
    color: #f6faff;
    text-shadow: 0 2px 24px rgba(10, 31, 61, .45);
  }
  .pp-hero-sub {
    position: relative; z-index: 1;
    margin-top: 1.1rem; max-width: 46rem;
    font-size: 1.06rem; line-height: 1.65;
    color: rgba(224, 237, 255, .88);
  }
  .pp-hero-cta { position: relative; z-index: 1; margin-top: 2.1rem; display: flex; flex-wrap: wrap; gap: .8rem; }
  .pp-btn-primary, .pp-btn-ghost {
    display: inline-flex; align-items: center; gap: .5rem;
    padding: .92rem 1.7rem; border-radius: 999px;
    font-weight: 600; font-size: .98rem; line-height: 1.2;
    transition: transform .18s ease, box-shadow .18s ease, background-color .18s ease;
  }
  .pp-btn-primary {
    color: #fff;
    background: linear-gradient(180deg, #3b82f6 0%, #1d4ed8 100%);
    box-shadow: 0 10px 28px rgba(29, 78, 216, .42), inset 0 1px 0 rgba(255,255,255,.22);
  }
  .pp-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 16px 36px rgba(29, 78, 216, .5); }
  .pp-btn-ghost { color: #e6efff; border: 1px solid rgba(255,255,255,.32); background: rgba(255,255,255,.04); }
  .pp-btn-ghost:hover { background: rgba(255,255,255,.1); transform: translateY(-2px); }

  .pp-metric {
    border: 1px solid #e3ecfa; border-radius: 20px;
    padding: 1.5rem 1rem; text-align: center;
    background: linear-gradient(180deg, #ffffff 0%, #f5f9ff 100%);
    box-shadow: 0 1px 2px rgba(16, 24, 40, .05), 0 14px 34px -14px rgba(29, 78, 216, .16);
    transition: transform .18s ease, box-shadow .18s ease;
  }
  .pp-metric:hover { transform: translateY(-3px); box-shadow: 0 1px 2px rgba(16,24,40,.05), 0 20px 44px -16px rgba(29, 78, 216, .24); }
  .pp-metric > div:first-child { font-size: 1.5rem; font-weight: 800; color: #1d4ed8; letter-spacing: -0.02em; }
  .pp-metric > div:last-child { margin-top: .35rem; font-size: .84rem; color: #64748b; }
</style>

  <style is:global>/* pp-brand-layer: эталон source_article.html, 2026-11-07 */
  :root { --pp-blue:#0B3D91; --pp-red:#E63946; --pp-bg:#F7F8FA; --pp-line:#EAECF0; --pp-ink:#101828; --pp-mut:#667085; }
  h2 { color: var(--pp-blue); border-bottom: 2px solid var(--pp-line); padding-bottom: .45rem; }
  h3 { color: var(--pp-ink); }
  table th { background: var(--pp-blue); color: #fff; }
  table td { border-bottom: 1px solid var(--pp-line); }
  summary { font-weight: 600; color: var(--pp-ink); }
  .pp-metric { background: var(--pp-bg); border: 1px solid var(--pp-line); border-radius: 10px; box-shadow: none; padding: 1.1rem .8rem; }
  .pp-metric > div:first-child { font-size: 1.55rem; font-weight: 800; color: var(--pp-blue); }
  .pp-metric > div:last-child { font-size: .82rem; color: var(--pp-mut); }
  .pp-hero-kicker { color: #b8d0f5; }
  .pp-hero-sub { color: rgba(230,238,251,.9); }
  .pp-hero { background:
    radial-gradient(720px 360px at 18% -8%, rgba(64,116,211,.4), transparent 62%),
    radial-gradient(560px 320px at 92% 12%, rgba(11,41,94,.6), transparent 60%),
    linear-gradient(158deg, #082A66 0%, #0B3D91 48%, #13479F 100%); }
  .pp-btn-primary { background: linear-gradient(180deg, #1d5fc2 0%, #0B3D91 100%); }
  a { text-decoration-color: var(--pp-line); }
  </style></head>
  <body class="bg-slate-50 text-slate-800 antialiased">
    <AWHeader {...headerData} isSticky showToggleTheme />

    <main class="mx-auto max-w-5xl px-4 py-10">
      <slot />
    </main>
    <AWFooter {...footerData} />

  <script defer src="/vendor/quicklink.umd.js"></script>
    <script>
      window.addEventListener('load', function () {
        // prefetch включается только на боевом домене: на превью пути другие
        if (location.hostname === 'polisprice.ru' && window.quicklink) {
          window.quicklink.listen({ priority: true, timeout: 3000 });
        }
      });
    </script>
</body>
</html>
